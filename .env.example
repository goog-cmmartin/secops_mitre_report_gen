# Google SecOps (Chronicle) Tenant Configuration
# Copy this file to .env and fill in your values
# DO NOT check your actual .env file into source control

CHRONICLE_PROJECT_ID=your-project-id
CHRONICLE_INSTANCE_ID=your-instance-guid
CHRONICLE_LOCATION=us

# Optional overrides
# CHRONICLE_DEFAULT_PROFILE=global_baseline
# CHRONICLE_LOOKBACK_DAYS=7
